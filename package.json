{
  "name": "mentalweg",
  "version": "1.0.0",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm run dev --prefix admin\" \"npm run dev --prefix public-app\" \"tsx verifier-api/src/standalone.ts\"",
    "verifier": "tsx verifier-api/src/standalone.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "build:vercel": "npm run build --prefix public-app && npm run build --prefix admin && node scripts/build-vercel.mjs",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@libsql/client": "^0.18.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^24.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
