# ===================================================================
# Mentalweg · Production & Railway Environment Variables
# ===================================================================

# Public application base URL (e.g. https://mentalweg.et or https://mentalweg.up.railway.app)
BASE_URL=https://mentalweg.up.railway.app

# Secret key for encrypting sessions/cookies (MUST be at least 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Persistent storage directory (Mount your Railway volume to /data)
DATA_DIR=/data

# Application HTTP Port (Railway automatically sets PORT; defaults to 3000)
PORT=3000

# Payment Verifier (Telebirr, CBE Birr, Dashen, Abyssinia receipt verification)
# For internal standalone verifier: http://localhost:3001
# Or an external verifier endpoint: https://verify.leul.et
VERIFIER_BASE_URL=http://localhost:3001
VERIFIER_API_KEY=replace_with_verifier_api_key

# Email Server (for booking confirmation & payment receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@mentalweg.et
SMTP_PASS=your-app-password

# Web Push Notifications (Optional: for browser appointment reminders)
# Generate pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudflare Turnstile anti-bot protection (Optional)
TURNSTILE_SECRET=
